# ==============================================================================
# CONFIGURACIÓN EL MEMORIALISTA - GENERADOR DE DOCUMENTOS JURÍDICOS COLOMBIA
# ==============================================================================

ENVIRONMENT=development
PORT=8000
DEBUG=True

# ------------------------------------------------------------------------------
# GOOGLE GEMINI API (https://aistudio.google.com/)
# ------------------------------------------------------------------------------
# Pega aquí tu clave gratuita de Google AI Studio:
GEMINI_API_KEY=

# Modelo principal (recomendado: gemini-2.5-flash o gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Modelos alternativos de respaldo automático si el principal está congestionado
GEMINI_FALLBACK_MODELS=gemini-1.5-flash,gemini-2.0-flash,gemini-1.5-pro,gemini-3.8-flash
