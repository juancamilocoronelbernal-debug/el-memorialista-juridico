# EL MEMORIALISTA v3 · copia este archivo como .env para desarrollo local.
# En producción configura estas variables en el servidor. Nunca publiques .env.
ENVIRONMENT=development
PORT=8000
DEBUG=False
LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:8000
KEEP_ALIVE=False

# SUPABASE · obligatorio para acceder al generador, también en desarrollo.
# URL del proyecto y clave anon/publishable. No pongas aquí una clave de servicio.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=archivos-privados
# Solo servidor. Opcional para iniciar sesión; necesaria para eliminar una cuenta
# desde la aplicación. Nunca se entrega al navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Oculta el registro público. Para acceso solo por invitación, desactiva también
# las altas públicas en Supabase Auth. Esta variable solo controla la interfaz.
AUTH_ALLOW_SIGNUP=False
AUTH_COOKIE_MAX_AGE_SECONDS=3600
# Vacío: frontend y API en el mismo origen. No es necesario añadir tu propia URL.
ALLOWED_ORIGINS=

# IP DEL CLIENTE · por defecto se usa la dirección de la conexión, sin cabeceras.
# Configura SOLO según el proxy real del alojamiento, nunca con valores de ejemplo.
# Lista explícita de IPs/CIDR del proxy que conecta al servidor y los saltos internos.
# El servidor ASGI también debe limitar qué proxies pueden reescribir request.client.
PROXY_IPS_CONFIABLES=
# Número exacto de proxies para leer X-Forwarded-For de derecha a izquierda.
# Todos los saltos confiados deben pertenecer a PROXY_IPS_CONFIABLES.
PROXIES_CONFIABLES=0
# Alternativa: cabecera exclusiva que el proxy REEMPLAZA, p. ej. True-Client-IP.
# Si se usa, conserva PROXIES_CONFIABLES=0 y declara PROXY_IPS_CONFIABLES.
# No se activa automáticamente por estar en Render u otro proveedor.
IP_CABECERA_CONFIABLE=

# GOOGLE GEMINI · solo servidor; necesario para redacción privada con IA.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_PRO=gemini-4-argon
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=65536
GEMINI_THINKING_DEFAULT=high
GEMINI_THINKING_COMPLEX=medium
GEMINI_SAFETY=

# GROQ · respaldo opcional, solo servidor.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# CUOTAS · contadores por proceso. Para varias réplicas usa un almacén compartido.
LIMITE_POR_VENTANA=15
VENTANA_MINUTOS=10
LIMITE_DIA_USUARIO=50
LIMITE_DIA_IP=150
LIMITE_DIA_GLOBAL=500
LIMITE_ESTILO_HORA=10

# APP_ACCESS_CODE y los tokens mock/test ya no permiten entrar al generador.
